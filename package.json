{
  "type": "module",
  "name": "kysely-generate",
  "version": "0.22.3",
  "author": "VastBlast",
  "license": "MIT",
  "bin": {
    "kysely-generate": "./dist/cli/bin.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VastBlast/kysely-generate.git"
  },
  "bugs": {
    "url": "https://github.com/VastBlast/kysely-generate/issues"
  },
  "homepage": "https://github.com/VastBlast/kysely-generate#readme",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "docker:up": "docker-compose up -d",
    "check:types": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --fix --type-aware",
    "check": "npm run lint && npm run check:types",
    "prepublishOnly": "npm run check && npm run build && npm run test",
    "start": "npm run build && DATABASE_URL=postgres://user:password@localhost:5433/database node ./dist/cli/bin.js",
    "test": "vitest run --globals --fileParallelism=false --maxConcurrency=1 --maxWorkers=1 --sequence.seed=1",
    "test:watch": "vitest watch --globals --fileParallelism=false --maxConcurrency=1 --maxWorkers=1 --sequence.seed=1"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "cosmiconfig": "^9.0.0",
    "diff": "^9.0.0",
    "dotenv": "^17.2.1",
    "dotenv-expand": "^13.0.0",
    "minimist": "^1.2.8",
    "picomatch": "^4.0.7",
    "pluralize": "^8.0.0",
    "postgres-array": "^3.0.4",
    "postgres-interval": "4.0.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@libsql/kysely-libsql": "^0.4.1",
    "@tediousjs/connection-string": "^1.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.3.11",
    "@types/minimist": "^1.2.5",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/picomatch": "^4.0.3",
    "@types/pluralize": "^0.0.33",
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.28.5",
    "kysely-bun-sqlite": "^0.4.0",
    "kysely-postgres-js": "^3.0.0",
    "mysql2": "^3.14.4",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^7.0.2002",
    "pg": "^8.16.3",
    "postgres": "^3.4.9",
    "prettier": "^3.6.2",
    "tarn": "^3.0.2",
    "tedious": "^19.1.3",
    "ts-dedent": "^2.2.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@libsql/kysely-libsql": ">=0.3.0 <0.5.0",
    "@tediousjs/connection-string": "^1.0.0",
    "better-sqlite3": ">=7.6.2 <14.0.0",
    "kysely": ">=0.27.0 <1.0.0",
    "kysely-bun-sqlite": ">=0.3.2 <1.0.0",
    "kysely-postgres-js": ">=3.0.0 <4.0.0",
    "mysql2": ">=2.3.3 <4.0.0",
    "pg": ">=8.8.0 <9.0.0",
    "postgres": ">=3.4.0 <4.0.0",
    "tarn": ">=3.0.0 <4.0.0",
    "tedious": ">=18.0.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "@libsql/kysely-libsql": {
      "optional": true
    },
    "@tediousjs/connection-string": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "kysely": {
      "optional": false
    },
    "kysely-bun-sqlite": {
      "optional": true
    },
    "kysely-postgres-js": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "tarn": {
      "optional": true
    },
    "tedious": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cli/bin": {
      "import": "./dist/cli/bin.js",
      "require": "./dist/cli/bin.cjs"
    },
    "./db": {
      "import": "./dist/db.js",
      "require": "./dist/db.cjs"
    },
    "./package.json": "./package.json"
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}
